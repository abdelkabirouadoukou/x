{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/*.lock",
      "!**/public/styles.css",
      "!**/.x",
      "!**/.vercel",
      "!**/scripts/bench/results",
      "!**/packages/core/src/__fixtures__/bench"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "**/pages/**/*.tsx",
        "**/templates/**/pages/**",
        "**/examples/blog/**",
        "**/examples/basic/**"
      ],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "includes": ["**/pages/docs/_layout.tsx", "**/templates/**/docs/_layout.tsx"],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/examples/landing/src/lib/syntax.tsx",
        "**/examples/landing/src/components/code-block.tsx",
        "**/templates/**/syntax.tsx"
      ],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" },
          "suspicious": { "noArrayIndexKey": "off" }
        }
      }
    },
    {
      "includes": ["**/examples/**", "**/templates/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off",
            "noStaticElementInteractions": "off",
            "useButtonType": "warn"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
