{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": true },
  "files": {
    "ignore": [
      "**/dist/**",
      "**/node_modules/**",
      "**/*.lock",
      "**/public/styles.css",
      "**/.x/**",
      "**/.vercel/**",
      "**/scripts/bench/results/**",
      "**/packages/core/src/__fixtures__/bench/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "include": [
        "**/pages/**/*.tsx",
        "**/templates/**/pages/**",
        "**/examples/blog/**",
        "**/examples/basic/**"
      ],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "include": ["**/pages/docs/_layout.tsx", "**/templates/**/docs/_layout.tsx"],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "include": ["**/examples/landing/src/lib/syntax.tsx", "**/templates/**/syntax.tsx"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" },
          "suspicious": { "noArrayIndexKey": "off" }
        }
      }
    },
    {
      "include": ["**/examples/**", "**/templates/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off",
            "useButtonType": "warn"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
