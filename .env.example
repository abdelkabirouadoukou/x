# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Convention: only variables prefixed `THEXJS_PUBLIC_` are safe to reference
# from client-shipped code. Everything else is server-only — reading it in a
# component, island, or action import fails the build.

# ---- Server ----
# Port the server listens on (default: 3000)
PORT=3000

# Set by the deploy platform; makes cookies `Secure` and picks production
# React builds. Don't set this to "development" in production.
NODE_ENV=production

# ---- Data layer (server-only) ----
# Used by connectPostgres / connectSQLite defaults.
DATABASE_URL=postgres://user:password@localhost:5432/mydb

# ---- Rate limiting (optional, multi-instance only) ----
# Used by createRedisRateLimitStore for cluster-wide rate limiting.
# REDIS_URL=redis://localhost:6379

# ---- Public (safe for client code) ----
# Example only: any THEXJS_PUBLIC_* variable may be read in the browser.
THEXJS_PUBLIC_API_URL=https://api.example.com

# ---- Secrets (server-only; never reference these in client code) ----
# STRIPE_SECRET_KEY=sk_live_...
