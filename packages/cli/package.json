{
  "name": "@thexjs/cli",
  "version": "0.1.1",
  "description": "Dev/build/start CLI for x framework apps. Requires Bun to run (https://bun.sh).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "x": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --target node18 --shims false --no-splitting",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@thexjs/core": "^0.1.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0"
  }
}
