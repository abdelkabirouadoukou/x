{
  "name": "@thexjs/cli",
  "version": "0.1.8",
  "description": "Dev/build/start CLI for x framework apps. Requires Bun to run (https://bun.sh).",
  "keywords": [
    "cli",
    "bun",
    "react",
    "framework",
    "dev-server",
    "build-tool",
    "x"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "x": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --target node18 --shims false --no-splitting",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@thexjs/core": "^0.1.7"
  },
  "peerDependencies": {
    "@thexjs/adapter-vercel": "^0.1.4"
  },
  "peerDependenciesMeta": {
    "@thexjs/adapter-vercel": {
      "optional": true
    }
  },
  "devDependencies": {
    "@thexjs/adapter-vercel": "^0.1.4",
    "react": "^19.0.0",
    "tsup": "^8.3.0"
  }
}
