{
  "name": "create-thexjs-app",
  "version": "1.1.3",
  "description": "Scaffold a new x framework app (npm create thexjs-app@latest).",
  "keywords": [
    "react",
    "bun",
    "bunjs",
    "framework",
    "fullstack",
    "full-stack",
    "meta-framework",
    "ssr",
    "ssg",
    "static-site-generator",
    "islands-architecture",
    "selective-hydration",
    "create-app",
    "cli",
    "scaffold",
    "starter",
    "generator",
    "template",
    "thexjs",
    "x-framework",
    "typescript",
    "file-based-routing",
    "server-functions",
    "server-actions",
    "api-routes",
    "loaders",
    "middleware",
    "content-collections",
    "markdown",
    "sqlite",
    "postgres",
    "zero-config",
    "ultra-fast"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-thexjs-app": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --target node18 --shims false --no-splitting",
    "build:watch": "tsup src/index.ts --format esm --target node18 --shims false --no-splitting --watch",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.3.0"
  }
}
