{
  "name": "create-thexjs-app",
  "version": "0.1.0",
  "description": "Scaffold a new x framework app (npm create thexjs-app@latest).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-thexjs-app": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --target node18 --shims false --no-splitting",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0"
  }
}
